<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      MoneyDev - Plantilla de Configuración de Secretos
      =================================================
      Instrucciones:
      1. Duplica este archivo y renómbralo a "Secrets.plist" en la raíz del proyecto o dentro de MoneyDev/
      2. Reemplaza el valor de GEMINI_API_KEY con tu clave de API de Google AI Studio:
         https://aistudio.google.com/app/apikey
      3. El archivo "Secrets.plist" está registrado en .gitignore para evitar que tus credenciales se suban a GitHub.
    -->
    <key>GEMINI_API_KEY</key>
    <string>YOUR_GEMINI_API_KEY_HERE</string>
</dict>
</plist>
