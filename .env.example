# MoneyDev - Variables de Entorno (Plantilla)
# ===============================================
# Duplica este archivo como ".env" para pruebas locales o CI/CD.
# Reemplaza el valor con tu clave de API de Google Gemini.
# El archivo ".env" real se encuentra excluido en .gitignore.

GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
